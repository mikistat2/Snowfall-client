# --- Database ---
# Either a single URL...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gym_management
# ...or discrete parts (used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gym_management

# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
