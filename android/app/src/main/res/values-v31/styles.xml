<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ replaced the old "draw a full-screen splash bitmap" approach
      with a system-drawn splash: the platform shows an icon on a solid colour
      while the process starts, and there is no way to opt out. Left
      unconfigured it uses @mipmap/ic_launcher over the theme's window
      background — which is exactly why the app opened on the stock Capacitor
      mark rather than the Snowfall logo.

      This qualifier folder overrides AppTheme.NoActionBarLaunch on API 31+
      only; the base values/styles.xml still drives Android 11 and below, where
      @drawable/splash is used instead.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>

        <!-- Stays behind the WebView after the system splash hands over, so
             there is no white flash before the first React render. -->
        <item name="android:background">@drawable/splash</item>
    </style>

</resources>
